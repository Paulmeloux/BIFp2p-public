# Export these environment variables in your shell or service manager.
# This file is an example only; the application does not load .env automatically.
BOT_TOKEN=REPLACE_WITH_TELEGRAM_BOT_TOKEN
COINOS_TOKEN=REPLACE_WITH_COINOS_API_TOKEN
BIFP2P_DB_PATH=users.db
COINOS_API_BASE=https://coinos.io/api
MARKET_PRICE_API_URL=REPLACE_WITH_YOUR_PRICE_API_URL

# Each independent operator must configure their own Telegram identities.
BIFP2P_ADMIN_ID=0
BIFP2P_CHANNEL_ID=REPLACE_WITH_YOUR_CHANNEL
BIFP2P_OFFICIAL_CHANNEL_ID=REPLACE_WITH_YOUR_CHANNEL
BIFP2P_OFFICIAL_CHANNEL_URL=REPLACE_WITH_YOUR_CHANNEL_URL
BIFP2P_OFFICIAL_GROUP_ID=REPLACE_WITH_YOUR_GROUP
BIFP2P_BOT_USERNAME=REPLACE_WITH_YOUR_BOT_USERNAME

# No outbound royalty payment is enabled by this template.
# ACCOUNTING_TEST records non-payable test obligations and requires the exact ACK.
# PRODUCTION_ENFORCED requires an explicitly enabled, configured wallet adapter.
ROYALTY_MODE=UNCONFIGURED
# ROYALTY_ACCOUNTING_TEST_ACK=I_UNDERSTAND_ACCOUNTING_TEST_IS_NOT_PRODUCTION
ROYALTY_PAYMENT_TRANSPORT_ENABLED=false
# Ready-made adapter: LNbits. Use a dedicated royalty wallet with a small balance.
ROYALTY_WALLET_ADAPTER=lnbits
ROYALTY_LNBITS_URL=REPLACE_WITH_HTTPS_LNBITS_ORIGIN
ROYALTY_LNBITS_ADMIN_KEY=REPLACE_WITH_DEDICATED_WALLET_ADMIN_KEY
# Beneficiary and 72-hour deadline are fixed in code, not operator settings.
BUYER_PAYOUT_PROCESSING_STALE_SECONDS=300
